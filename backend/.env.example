# ================================================================
# KONFIGURASI ENVIRONMENT APLIKASI MAPEL DWISMA
# ================================================================
# Salin file ini menjadi .env dan isi nilai yang sesuai:
#   cp .env.example .env
# ================================================================

# ---- SERVER ----
PORT=3000

# ---- KEAMANAN (WAJIB DIUBAH sebelum deploy ke production!) ----
# Gunakan string acak yang panjang dan tidak bisa ditebak,
# contoh: openssl rand -hex 64
JWT_SECRET=ganti-dengan-secret-key-yang-kuat-dan-panjang

# ---- RATE LIMITING (Opsional) ----
# Batas percobaan login (default: 30)
LOGIN_LIMIT_MAX=30
# Jendela waktu dalam menit (default: 15)
LOGIN_LIMIT_WINDOW_MINS=15

# ---- DATABASE ----
# SQLite - file disimpan otomatis di backend/data/database.sqlite
# Tidak perlu URL koneksi, cukup pastikan folder backend/data/ bisa ditulis
